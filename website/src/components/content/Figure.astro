---
/**
 * A photograph inside a piece of writing.
 *
 * Images live in `public/Images/` and are referenced by path rather than
 * imported, so a content file never has to know about Astro's asset pipeline.
 * That keeps an MDX file portable: drop the photo in the folder, point at it,
 * done. The trade-off is that nothing checks the path at build time, so a typo
 * ships as a broken image rather than a failed build — worth a look at the page
 * before publishing.
 *
 * `alt` and `caption` are separate on purpose. `alt` describes the photograph
 * for a reader who cannot see it; `caption` is the line printed underneath for
 * everyone. A caption that simply repeats the alt text is noise in one of the
 * two places, so write them differently or leave the caption off.
 */
export interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** Portrait photographs are capped shorter so they don't swallow the column. */
  orientation?: 'landscape' | 'portrait';
}

const { src, alt, caption, orientation = 'landscape' } = Astro.props;
---

<figure class:list={['figure', `figure--${orientation}`]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2.5rem 0;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 6px;
    border: 1px solid var(--color-rule);
  }

  .figure--portrait img {
    max-width: 480px;
    margin-inline: auto;
  }

  .figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-ink-tertiary);
    text-align: left;
  }

  .figure--portrait figcaption {
    max-width: 480px;
    margin-inline: auto;
  }
</style>
