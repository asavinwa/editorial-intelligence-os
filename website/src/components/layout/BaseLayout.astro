---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import FlagshipJourney from '../FlagshipJourney.astro';
import { SITE } from '../../config/site';
import '../../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  ogImage?: string;
  pageType?: 'website' | 'collection' | 'article' | 'service' | 'profile';
  datePublished?: Date | string;
  dateModified?: Date | string;
  noindex?: boolean;
  suppressFlagshipJourney?: boolean;
}

const {
  title,
  description = SITE.description,
  ogDescription = description,
  ogImage,
  pageType = 'website',
  datePublished,
  dateModified,
  noindex = false,
  suppressFlagshipJourney = false,
} = Astro.props;

const pageTitle = title
  ? title.includes(SITE.name) ? title : `${title} — ${SITE.name}`
  : SITE.title;
const metaDescription = description.length > 160
  ? `${description.slice(0, 157).replace(/\s+\S*$/, '')}…`
  : description;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const socialImage = new URL(ogImage ?? '/og-image.png', SITE.url).toString();
const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;

const nameOverrides: Record<string, string> = {
  'editorial-intelligence-os': 'Editorial Intelligence OS',
  'ai-visibility-audit': 'AI Visibility Audit',
  'research-led-thought-leadership': 'Research-led thought leadership',
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = segments.map((segment, index) => ({
  '@type': 'ListItem',
  position: index + 2,
  name: index === segments.length - 1 && title
    ? title.split('|')[0].trim()
    : nameOverrides[segment] ?? segment.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()),
  item: new URL(`/${segments.slice(0, index + 1).join('/')}`, SITE.url).toString(),
}));

const pageSchemaType = pageType === 'collection'
  ? 'CollectionPage'
  : pageType === 'profile'
    ? 'ProfilePage'
    : 'WebPage';

const pageSchema = pageType === 'article'
  ? {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: title,
      description,
      image: socialImage,
      mainEntityOfPage: canonical,
      author: { '@id': personId },
      publisher: { '@id': personId },
      datePublished: datePublished ? new Date(datePublished).toISOString() : undefined,
      dateModified: dateModified ? new Date(dateModified).toISOString() : undefined,
      inLanguage: 'en-GB',
    }
  : pageType === 'service'
    ? {
        '@type': 'Service',
        '@id': `${canonical}#service`,
        name: title,
        description,
        url: canonical,
        provider: { '@id': personId },
        areaServed: { '@type': 'Country', name: 'United Kingdom' },
      }
    : {
        '@type': pageSchemaType,
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: pageTitle,
        description,
        isPartOf: { '@id': websiteId },
        about: pageType === 'profile' ? { '@id': personId } : undefined,
        inLanguage: 'en-GB',
      };

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      creator: { '@id': personId },
      inLanguage: 'en-GB',
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.author,
      url: `${SITE.url}/about`,
      image: new URL(SITE.authorImage, SITE.url).toString(),
      email: `mailto:${SITE.email}`,
      jobTitle: 'Editorial Intelligence practitioner',
      sameAs: SITE.profiles,
    },
    pageSchema,
    ...(segments.length > 0 ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        ...breadcrumbItems,
      ],
    }] : []),
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Editorial Intelligence — Knowledge that compounds." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Editorial Intelligence — Knowledge that compounds." />

    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/*
      Self-hosted fonts. One stylesheet in public/ so the standalone diagnostic
      page can share it — it cannot import from src/. Do not reintroduce
      fonts.googleapis.com: it sends every visitor's IP to Google, and /privacy
      states that no such transfer happens.
    */}
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/-nFnOHM81r4j6k0gjAW3mujVU2B2G_Bx0g.woff2" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    {!suppressFlagshipJourney && <FlagshipJourney />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      if (typeof window !== 'undefined' && window.localStorage.getItem('ei_owner') === 'true') {
        window.__va_disable = true;
      }
    </script>
  </body>
</html>
