---
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import FlagshipJourney from '../FlagshipJourney.astro';
import { SITE } from '../../config/site';
import '../../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title?: string;
  description?: string;
  ogDescription?: string;
  ogImage?: string;
  pageType?: 'website' | 'collection' | 'article' | 'service' | 'profile';
  datePublished?: Date | string;
  dateModified?: Date | string;
  noindex?: boolean;
  suppressFlagshipJourney?: boolean;
}

const {
  title,
  description = SITE.description,
  ogDescription = description,
  ogImage,
  pageType = 'website',
  datePublished,
  dateModified,
  noindex = false,
  suppressFlagshipJourney = false,
} = Astro.props;

const pageTitle = title
  ? title.includes(SITE.name) ? title : `${title} — ${SITE.name}`
  : SITE.title;
const metaDescription = description.length > 160
  ? `${description.slice(0, 157).replace(/\s+\S*$/, '')}…`
  : description;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const socialImage = new URL(ogImage ?? '/og-image.png', SITE.url).toString();
const personId = `${SITE.url}/#person`;
const websiteId = `${SITE.url}/#website`;

const nameOverrides: Record<string, string> = {
  'editorial-intelligence-os': 'Editorial Intelligence OS',
  'ai-visibility-audit': 'AI Visibility Audit',
  'research-led-thought-leadership': 'Research-led thought leadership',
};

const segments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = segments.map((segment, index) => ({
  '@type': 'ListItem',
  position: index + 2,
  name: index === segments.length - 1 && title
    ? title.split('|')[0].trim()
    : nameOverrides[segment] ?? segment.replaceAll('-', ' ').replace(/\b\w/g, (letter) => letter.toUpperCase()),
  item: new URL(`/${segments.slice(0, index + 1).join('/')}`, SITE.url).toString(),
}));

const pageSchemaType = pageType === 'collection'
  ? 'CollectionPage'
  : pageType === 'profile'
    ? 'ProfilePage'
    : 'WebPage';

const pageSchema = pageType === 'article'
  ? {
      '@type': 'Article',
      '@id': `${canonical}#article`,
      headline: title,
      description,
      image: socialImage,
      mainEntityOfPage: canonical,
      author: { '@id': personId },
      publisher: { '@id': personId },
      datePublished: datePublished ? new Date(datePublished).toISOString() : undefined,
      dateModified: dateModified ? new Date(dateModified).toISOString() : undefined,
      inLanguage: 'en-GB',
    }
  : pageType === 'service'
    ? {
        '@type': 'Service',
        '@id': `${canonical}#service`,
        name: title,
        description,
        url: canonical,
        provider: { '@id': personId },
        areaServed: { '@type': 'Country', name: 'United Kingdom' },
      }
    : {
        '@type': pageSchemaType,
        '@id': `${canonical}#webpage`,
        url: canonical,
        name: pageTitle,
        description,
        isPartOf: { '@id': websiteId },
        about: pageType === 'profile' ? { '@id': personId } : undefined,
        inLanguage: 'en-GB',
      };

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      creator: { '@id': personId },
      inLanguage: 'en-GB',
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: SITE.author,
      url: `${SITE.url}/about`,
      image: new URL(SITE.authorImage, SITE.url).toString(),
      email: `mailto:${SITE.email}`,
      jobTitle: 'Editorial Intelligence practitioner',
      sameAs: SITE.profiles,
    },
    pageSchema,
    ...(segments.length > 0 ? [{
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
        ...breadcrumbItems,
      ],
    }] : []),
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Editorial Intelligence — Knowledge that compounds." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Editorial Intelligence — Knowledge that compounds." />

    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Nav />
    {!suppressFlagshipJourney && <FlagshipJourney />}
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <script>
      if (typeof window !== 'undefined' && window.localStorage.getItem('ei_owner') === 'true') {
        window.__va_disable = true;
      }

      if (window.location.pathname === '/applications/marketing' || window.location.pathname === '/applications/marketing/') {
        const style = document.createElement('style');
        style.textContent = `
          .marketing-page { padding: 3.5rem 0 5rem !important; }
          .marketing-page h1,
          .marketing-page h2,
          .marketing-page h3,
          .marketing-page blockquote,
          .marketing-page .hero-thesis {
            font-family: var(--font-serif) !important;
            font-weight: 400 !important;
          }
          .marketing-page .hero { gap: clamp(2.5rem, 5vw, 5rem) !important; padding-bottom: 4rem !important; }
          .marketing-page .hero h1 { font-size: clamp(2.65rem, 5vw, 4.25rem) !important; line-height: 1.06 !important; letter-spacing: -.02em !important; margin-bottom: 1.6rem !important; }
          .marketing-page .hero-thesis { font-size: clamp(1.18rem, 2vw, 1.5rem) !important; line-height: 1.45 !important; margin-bottom: 1.1rem !important; }
          .marketing-page .hero-summary { font-size: 1rem !important; line-height: 1.72 !important; }
          .marketing-page .page-grid { grid-template-columns: 10.5rem minmax(0, 44rem) !important; gap: clamp(2.5rem, 5vw, 5rem) !important; }
          .marketing-page .chapter { padding: 3.75rem 0 !important; }
          .marketing-page .chapter h2 { font-size: clamp(1.75rem, 3vw, 2.35rem) !important; line-height: 1.18 !important; letter-spacing: -.015em !important; margin: .85rem 0 1.5rem !important; }
          .marketing-page .prose { gap: 1rem !important; max-width: 40rem !important; }
          .marketing-page .prose p { font-size: .98rem !important; line-height: 1.72 !important; }
          .marketing-page blockquote { margin-top: 2.25rem !important; padding-top: 1.5rem !important; font-size: clamp(1.25rem, 2.3vw, 1.75rem) !important; }
          .marketing-page .principle-card { padding: 1.25rem !important; min-height: 10.5rem !important; }
          .marketing-page .principle-card h3 { font-size: 1.05rem !important; margin: 1.6rem 0 .65rem !important; letter-spacing: -.01em !important; }
          .marketing-page .principle-card p { font-size: .84rem !important; line-height: 1.58 !important; }
          .marketing-page .evidence-card { padding: 1.25rem !important; }
          .marketing-page .evidence-card h3 { font-size: 1.18rem !important; margin: .8rem 0 1rem !important; letter-spacing: -.01em !important; }
          .marketing-page .learning-system,
          .marketing-page .connected-model { margin: 2.25rem 0 !important; }
          .marketing-page .next-step-card { min-height: 15rem !important; padding: 1.25rem !important; }
          .marketing-page .next-step-card h3 { margin: 1.4rem 0 .7rem !important; font-size: 1.15rem !important; letter-spacing: -.01em !important; }
          .marketing-page .chapter-nav a { font-size: .72rem !important; padding: .45rem .7rem !important; }
          .marketing-page .ai-chapter h2 { font-size: clamp(1.9rem, 3.4vw, 2.65rem) !important; }
          @media (max-width: 1024px) {
            .marketing-page .page-grid { grid-template-columns: 1fr !important; }
          }
          @media (max-width: 680px) {
            .marketing-page { padding-top: 2.5rem !important; }
            .marketing-page .hero { padding-bottom: 3rem !important; }
            .marketing-page .hero h1 { font-size: 2.55rem !important; }
            .marketing-page .chapter { padding: 3rem 0 !important; }
          }
        `;
        document.head.appendChild(style);
      }

      if (window.location.pathname === '/' || window.location.pathname === '') {
        const cards = Array.from(document.querySelectorAll<HTMLAnchorElement>('.hero-text > a.guide-callout'));
        const byHref = new Map(cards.map((card) => [card.getAttribute('href'), card]));
        const start = byHref.get('/start');
        const guide = byHref.get('/guide');
        const assessment = byHref.get('/assessment');
        const narrativeAudit = byHref.get('/work/narrative-audit');
        const startupAudit = byHref.get('/work/startup-narrative-audit');
        const aiVisibility = byHref.get('/work/ai-visibility-audit');
        const researchLed = byHref.get('/work/research-led-thought-leadership');

        if (start && guide && assessment && narrativeAudit && startupAudit && aiVisibility && researchLed) {
          const marketing = guide.cloneNode(true) as HTMLAnchorElement;
          marketing.href = '/applications/marketing';
          const badge = marketing.querySelector('.guide-callout-badge');
          const title = marketing.querySelector('.guide-callout-title');
          const description = marketing.querySelector('.guide-callout-sub');

          if (badge) badge.textContent = 'Apply';
          if (title) title.textContent = 'Editorial Intelligence for marketing';
          if (description) description.textContent = 'See how the discipline connects research, customer evidence, campaign learning and internal expertise →';

          const parent = start.parentElement;
          if (parent) {
            const journeyHeader = document.createElement('div');
            journeyHeader.className = 'mb-5';
            journeyHeader.innerHTML = `
              <p class="t-label mb-2">Start your journey</p>
              <p class="guide-callout-sub">Four steps to understand and apply Editorial Intelligence.</p>
            `;

            parent.insertBefore(journeyHeader, start);
            [start, guide, marketing, assessment].forEach((card) => parent.insertBefore(card, aiVisibility));

            const credibility = parent.querySelector('.hero-credibility');
            if (credibility) {
              const servicesHeader = document.createElement('div');
              servicesHeader.className = 'mt-8 mb-4';
              servicesHeader.innerHTML = `
                <p class="t-label mb-2">Specialist services</p>
                <p class="guide-callout-sub">Focused help for specific visibility and narrative problems.</p>
              `;
              parent.insertBefore(servicesHeader, credibility);
              parent.insertBefore(narrativeAudit, credibility);
              parent.insertBefore(startupAudit, credibility);
              parent.insertBefore(aiVisibility, credibility);
              parent.insertBefore(researchLed, credibility);
            }
          }
        }
      }
    </script>
  </body>
</html>
