---
import { SITE } from '../../config/site';
const pathname = Astro.url.pathname;

const navDescriptions: Record<string, string> = {
  '/intelligence': 'The discipline',
  '/editorial-intelligence-os': 'The operating system',
  '/applications': 'The OS in practice',
  '/writing': 'Thinking in development',
  '/work': 'Implement Editorial Intelligence',
  '/about': 'Background',
};

const isCurrentPath = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
const isItemActive = (item: (typeof SITE.nav)[number]) =>
  isCurrentPath(item.href) || ('children' in item && item.children.some((child) => isCurrentPath(child.href)));
---

<header class="border-b border-[var(--color-rule,#2c2920)] sticky top-0 z-50 nav-header">
  <div class="container-site">
    <nav class="flex items-center justify-between h-16" aria-label="Main navigation">
      <a href="/" class="flex items-center gap-3 no-underline group">
        <span class="nav-logo">EI<span class="nav-logo-sep"> / </span>OS</span>
      </a>

      <!-- Desktop nav -->
      <ul class="hidden lg:flex items-center gap-8 list-none m-0 p-0">
        {SITE.nav.map((item) => {
          const isActive = isItemActive(item);
          const desc = navDescriptions[item.href];
          return (
            <li class:list={['nav-entry', 'children' in item ? 'nav-group' : '']}>
              <a
                href={item.href}
                class:list={[
                  'no-underline transition-colors flex flex-col gap-0.5 nav-item',
                  isActive ? 'nav-item--active' : '',
                ]}
              >
                <span class:list={[
                  'nav-label',
                  isActive ? 'text-[var(--color-ink)]' : 'text-[var(--color-ink-secondary)]',
                ]}>
                  {item.label}
                  {'children' in item && (
                    <svg class="nav-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                      <path d="m2 3.5 3 3 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                </span>
                {desc && (
                  <span class="nav-desc">{desc}</span>
                )}
              </a>
              {'children' in item && (
                <div class="nav-dropdown">
                  <div class="nav-dropdown-inner">
                    {item.children.map((child) => {
                      const childActive = isCurrentPath(child.href);
                      return (
                        <a href={child.href} class:list={['nav-child', childActive ? 'nav-child--active' : '']}>
                          <span class="nav-child-label">{child.label}</span>
                          <span class="nav-child-desc">{child.description}</span>
                        </a>
                      );
                    })}
                  </div>
                </div>
              )}
            </li>
          );
        })}
      </ul>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        class="lg:hidden p-2 -mr-2 text-[var(--color-ink-tertiary)]"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--color-surface-tertiary)]">
    <ul class="container-site py-4 flex flex-col gap-4 list-none m-0 p-0">
      {SITE.nav.map((item) => {
        const isActive = isItemActive(item);
        return (
          <li>
            {'children' in item ? (
              <details class="mobile-nav-group" open={isActive}>
                <summary class:list={['mobile-nav-summary', isActive ? 'mobile-nav-active' : '']}>
                  <span>{item.label}</span>
                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="m2.5 4.5 3.5 3 3.5-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </summary>
                <ul class="mobile-nav-children list-none">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} class:list={['mobile-nav-child', isCurrentPath(child.href) ? 'mobile-nav-active' : '']}>
                        <span>{child.label}</span>
                        <span class="mobile-nav-child-desc">{child.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={item.href}
                class:list={['mobile-nav-link', isActive ? 'mobile-nav-active' : '']}
              >
                {item.label}
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</header>

<style>
  .nav-label {
    font-size: 0.8125rem;
    font-weight: 500;
    transition: color 0.15s;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .nav-item:hover .nav-label {
    color: var(--color-ink);
  }

  .nav-item--active .nav-label {
    color: var(--color-ink);
  }

  .nav-desc {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--color-ink-tertiary);
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.15s, transform 0.15s;
  }

  .nav-item:hover .nav-desc,
  .nav-item--active .nav-desc {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-header {
    background: color-mix(in srgb, var(--color-surface) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .nav-entry {
    position: relative;
  }

  .nav-chevron {
    transition: transform 0.15s ease;
  }

  .nav-group:hover .nav-chevron,
  .nav-group:focus-within .nav-chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    width: 17rem;
    padding-top: 1.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, -0.35rem);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
  }

  .nav-dropdown::before {
    content: '';
    position: absolute;
    inset: 0.25rem 0 auto;
    height: 1px;
    background: var(--color-accent);
  }

  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .nav-dropdown-inner {
    display: flex;
    flex-direction: column;
    padding: 0.65rem;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.12);
  }

  .nav-child {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.65rem 0.75rem;
    color: var(--color-ink-secondary);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .nav-child:hover,
  .nav-child:focus,
  .nav-child--active {
    color: var(--color-ink);
    background: var(--color-surface-secondary);
  }

  .nav-child-label {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .nav-child-desc {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-tertiary);
    letter-spacing: 0.02em;
  }

  .mobile-nav-link,
  .mobile-nav-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .mobile-nav-summary {
    list-style: none;
  }

  .mobile-nav-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav-summary svg {
    transition: transform 0.15s ease;
  }

  .mobile-nav-group[open] .mobile-nav-summary svg {
    transform: rotate(180deg);
  }

  .mobile-nav-children {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0.75rem 0 0;
    padding: 0 0 0 1rem;
    border-left: 1px solid var(--color-rule);
  }

  .mobile-nav-child {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.45rem 0.65rem;
    color: var(--color-ink-secondary);
    text-decoration: none;
  }

  .mobile-nav-child-desc {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-tertiary);
  }

  .mobile-nav-active {
    color: var(--color-ink);
  }

  .nav-logo {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--color-ink);
    transition: color 0.2s;
  }

  .nav-logo-sep {
    color: var(--color-accent);
    margin: 0 0.05em;
  }

  a:hover .nav-logo {
    color: var(--color-accent);
  }
</style>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
  });
</script>
