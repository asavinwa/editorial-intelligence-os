---
interface Props {
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const rawPathname = Astro.url.pathname;
const pathname = rawPathname !== '/' ? rawPathname.replace(/\/+$/, '') : '/';

const journeys: Record<string, {
  eyebrow: string;
  title: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}> = {
  '/guide': {
    eyebrow: 'Application',
    title: 'See the discipline applied to marketing',
    body: 'Use the marketing application as a practical example after exploring the core discipline in this guide.',
    primaryLabel: 'Explore the marketing application',
    primaryHref: '/applications/marketing',
  },
  '/work/narrative-audit': {
    eyebrow: 'The thinking behind the audit',
    title: 'Editorial Intelligence for marketing',
    body: 'The audit applies a wider discipline as a fixed-scope engagement. See how Editorial Intelligence connects research, customer evidence, campaign learning and internal expertise across a marketing organisation.',
    primaryLabel: 'Explore the marketing application',
    primaryHref: '/applications/marketing',
  },
};

const journey = journeys[pathname];
---

{journey && pathname !== '/applications/marketing' && (
  <aside
    class:list={['flagship-journey', embedded && 'flagship-journey--embedded']}
    aria-label="Recommended Editorial Intelligence journey"
  >
    <div class:list={['flagship-journey-inner', !embedded && 'container-site']}>
      <div class="flagship-journey-copy">
        <p class="t-label">{journey.eyebrow}</p>
        <h2>{journey.title}</h2>
        <p>{journey.body}</p>
      </div>
      <div class="flagship-journey-actions">
        <a class="flagship-primary" href={journey.primaryHref}>{journey.primaryLabel} →</a>
        {journey.secondaryHref && journey.secondaryLabel && (
          <a class="flagship-secondary" href={journey.secondaryHref}>{journey.secondaryLabel} →</a>
        )}
      </div>
    </div>
  </aside>
)}

<style>
  .flagship-journey {
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-surface-secondary);
  }
  .flagship-journey-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .flagship-journey-copy { max-width: 46rem; }
  .flagship-journey--embedded {
    margin-top: 2rem;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
  }
  .flagship-journey--embedded .flagship-journey-inner {
    padding: 1.5rem;
  }
  .flagship-journey-copy h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    line-height: 1.25;
    color: var(--color-ink);
  }
  .flagship-journey-copy > p:last-child {
    margin-top: 0.5rem;
    color: var(--color-ink-secondary);
    line-height: 1.65;
  }
  .flagship-journey-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 13rem;
  }
  .flagship-primary,
  .flagship-secondary {
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .flagship-primary { color: var(--color-accent); font-weight: 600; }
  .flagship-secondary { color: var(--color-ink-secondary); }
  .flagship-primary:hover,
  .flagship-secondary:hover { color: var(--color-ink); }

  @media (max-width: 760px) {
    .flagship-journey-inner { grid-template-columns: 1fr; gap: 1.25rem; }
    .flagship-journey-actions { min-width: 0; }
  }
</style>
