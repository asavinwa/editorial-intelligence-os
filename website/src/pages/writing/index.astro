---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import KeepInTouch from '../../components/KeepInTouch.astro';

const writing = await getCollection('writing', ({ data }) => data.status === 'published');
const sorted = writing.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const essays = sorted.filter(w => w.data.type === 'article' || w.data.type === 'reflection');
const notes = sorted.filter(w => w.data.type === 'note');

const startHereSlugs = [
  'what-is-editorial-intelligence',
  'from-journalist-to-editorial-architect',
  'editorial-judgement-competitive-advantage',
];
const startHere = startHereSlugs
  .map(slug => essays.find(essay => essay.slug === slug))
  .filter(Boolean);
const latest = essays.slice(0, 3);

const themes = [
  { id: 'editorial-intelligence', label: 'Editorial Intelligence' },
  { id: 'ai-judgement', label: 'AI and judgement' },
  { id: 'editorial-systems', label: 'Editorial systems' },
  { id: 'evidence-practice', label: 'Evidence in practice' },
];

function themeFor(tags: readonly string[]) {
  if (tags.some(tag => ['ai', 'ai-workflows', 'ai-maturity', 'trusted-ai'].includes(tag))) return 'ai-judgement';
  if (tags.some(tag => ['editorial-systems', 'knowledge-systems', 'editorial-operations', 'workflow-design'].includes(tag))) return 'editorial-systems';
  if (tags.some(tag => ['research', 'evidence', 'events', 'customer-insight'].includes(tag))) return 'evidence-practice';
  return 'editorial-intelligence';
}

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-GB', { year: 'numeric', month: 'short', day: 'numeric' }).format(date);
}
---

<BaseLayout
  title="Writing and field notes"
  description="Essays, observations and emerging arguments from the development of Editorial Intelligence."
  pageType="collection"
>
  <div class="container-site py-16">
    <header class="mb-12 max-w-2xl">
      <p class="t-label mb-4">Field notes</p>
      <h1 class="t-heading mb-4">Writing and field notes</h1>
      <p class="t-body">Essays, observations and emerging arguments from the development of Editorial Intelligence.</p>
    </header>

    <hr class="divider mb-14" />

    <section class="mb-16" aria-labelledby="start-here-heading">
      <div class="section-heading">
        <div>
          <p class="t-label mb-3">New to the idea?</p>
          <h2 id="start-here-heading" class="section-title">Start here</h2>
        </div>
        <p>Three pieces that explain the discipline, the work behind it and why editorial judgement matters now.</p>
      </div>
      <div class="start-grid">
        {startHere.map((essay, index) => essay && (
          <a href={`/writing/${essay.slug}`} class="start-card group">
            <span class="start-number">0{index + 1}</span>
            <h3 class="card-title group-hover:text-[var(--color-accent)] transition-colors">{essay.data.title}</h3>
            <p class="card-excerpt">{essay.data.excerpt}</p>
            <span class="card-read">{essay.data.readTime} min read</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-16" aria-labelledby="latest-heading">
      <div class="section-heading">
        <div>
          <p class="t-label mb-3">Recently published</p>
          <h2 id="latest-heading" class="section-title">Latest writing</h2>
        </div>
      </div>
      <div class="latest-grid">
        {latest.map(essay => (
          <a href={`/writing/${essay.slug}`} class="article-card group">
            <div class="card-meta">
              <span>{formatDate(essay.data.date)}</span>
              <span>{essay.data.readTime} min</span>
            </div>
            <h3 class="card-title group-hover:text-[var(--color-accent)] transition-colors">{essay.data.title}</h3>
            <p class="card-excerpt">{essay.data.excerpt}</p>
            <span class="card-link">Read →</span>
          </a>
        ))}
      </div>
    </section>

    <section class="mb-16" aria-labelledby="explore-heading">
      <div class="section-heading">
        <div>
          <p class="t-label mb-3">The full archive</p>
          <h2 id="explore-heading" class="section-title">Explore by theme</h2>
        </div>
        <p>Follow the argument that interests you, or browse everything.</p>
      </div>

      <div class="theme-filters" role="group" aria-label="Filter writing by theme">
        <button type="button" class="theme-filter is-active" data-theme="all" aria-pressed="true">All writing</button>
        {themes.map(theme => (
          <button type="button" class="theme-filter" data-theme={theme.id} aria-pressed="false">{theme.label}</button>
        ))}
      </div>

      <p class="filter-status" aria-live="polite">Showing all {essays.length} pieces</p>
      <div class="archive-grid">
        {essays.map(essay => {
          const theme = themeFor(essay.data.tags);
          const themeLabel = themes.find(item => item.id === theme)?.label;
          return (
            <a href={`/writing/${essay.slug}`} class="article-card group" data-article-theme={theme}>
              <div class="card-meta">
                <span class="theme-label">{themeLabel}</span>
                <span>{essay.data.readTime} min</span>
              </div>
              <h3 class="card-title group-hover:text-[var(--color-accent)] transition-colors">{essay.data.title}</h3>
              <p class="card-excerpt">{essay.data.excerpt}</p>
            </a>
          );
        })}
      </div>
    </section>

    {notes.length > 0 && (
      <section aria-labelledby="signal-notes-heading">
        <hr class="divider mb-12" />
        <div class="section-heading">
          <div>
            <p class="t-label mb-3">Evidence in motion</p>
            <h2 id="signal-notes-heading" class="section-title">Signal notes</h2>
          </div>
          <p>Shorter observations from research, events and source material that feed the wider Editorial Intelligence evidence base.</p>
        </div>
        <div class="notes-list">
          {notes.map(note => (
            <a href={`/writing/${note.slug}`} class="note-row group">
              <div class="note-row-left">
                <span class="note-row-title group-hover:text-[var(--color-ink)] transition-colors">{note.data.title}</span>
                <span class="note-row-excerpt">{note.data.excerpt}</span>
              </div>
              <div class="note-row-right">
                <span>{formatDate(note.data.date)}</span>
                <span>{note.data.readTime} min</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <KeepInTouch />
  </div>
</BaseLayout>

<script>
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-article-theme]'));
  const status = document.querySelector<HTMLElement>('.filter-status');

  filters.forEach(filter => {
    filter.addEventListener('click', () => {
      const selected = filter.dataset.theme ?? 'all';
      let visible = 0;

      filters.forEach(item => {
        const active = item === filter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      cards.forEach(card => {
        const show = selected === 'all' || card.dataset.articleTheme === selected;
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (status) {
        const label = filter.textContent?.trim().toLowerCase() ?? 'writing';
        status.textContent = selected === 'all' ? `Showing all ${visible} pieces` : `Showing ${visible} pieces on ${label}`;
      }
    });
  });
</script>

<style>
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1.5rem; }
  .section-heading > p { max-width: 48ch; font-size: 0.8125rem; line-height: 1.65; color: var(--color-ink-tertiary); }
  .section-title { font-family: var(--font-serif); font-size: clamp(1.35rem, 3vw, 1.8rem); font-weight: 400; line-height: 1.2; color: var(--color-ink); }
  .start-grid, .latest-grid, .archive-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; }
  .start-card, .article-card { display: flex; flex-direction: column; gap: 0.65rem; padding: 1.35rem; border: 1px solid var(--color-rule); border-radius: 4px; background: var(--color-surface-secondary); text-decoration: none; transition: background 0.15s, border-color 0.15s; }
  .start-card { border-top: 2px solid var(--color-accent); }
  .start-card:hover, .article-card:hover { background: var(--color-surface-tertiary); border-color: color-mix(in srgb, var(--color-accent) 25%, var(--color-rule)); }
  .start-number { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.08em; color: var(--color-accent); }
  .card-meta { display: flex; justify-content: space-between; gap: 1rem; font-family: var(--font-mono); font-size: 0.5625rem; letter-spacing: 0.06em; color: var(--color-ink-tertiary); opacity: 0.75; }
  .theme-label { color: var(--color-accent); text-transform: uppercase; letter-spacing: 0.08em; }
  .card-title { font-family: var(--font-serif); font-size: 1.05rem; font-weight: 400; color: var(--color-ink); line-height: 1.35; }
  .card-excerpt { font-size: 0.8125rem; line-height: 1.65; color: var(--color-ink-tertiary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-read, .card-link { margin-top: auto; padding-top: 0.4rem; font-size: 0.75rem; color: var(--color-ink-tertiary); }
  .card-link { color: var(--color-accent); font-weight: 500; }
  .theme-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem; }
  .theme-filter { padding: 0.5rem 0.8rem; border: 1px solid var(--color-rule); border-radius: 999px; background: transparent; color: var(--color-ink-secondary); font-size: 0.75rem; line-height: 1; cursor: pointer; transition: 0.15s; }
  .theme-filter:hover { border-color: var(--color-accent); color: var(--color-ink); }
  .theme-filter:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .theme-filter.is-active { background: var(--color-ink); border-color: var(--color-ink); color: var(--color-surface); }
  .filter-status { margin-bottom: 1.25rem; font-family: var(--font-mono); font-size: 0.5625rem; letter-spacing: 0.05em; color: var(--color-ink-tertiary); }
  .article-card[hidden] { display: none; }
  .notes-list { display: flex; flex-direction: column; border: 1px solid var(--color-rule); border-radius: 4px; overflow: hidden; }
  .note-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-rule); background: var(--color-surface-secondary); text-decoration: none; transition: background 0.15s; }
  .note-row:last-child { border-bottom: none; }
  .note-row:hover { background: var(--color-surface-tertiary); }
  .note-row-left { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .note-row-title { font-size: 0.875rem; font-weight: 500; color: var(--color-ink-secondary); line-height: 1.4; }
  .note-row-excerpt { font-size: 0.75rem; line-height: 1.55; color: var(--color-ink-tertiary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .note-row-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; flex-shrink: 0; font-family: var(--font-mono); font-size: 0.5625rem; letter-spacing: 0.06em; color: var(--color-ink-tertiary); opacity: 0.6; white-space: nowrap; }
  @media (min-width: 640px) { .start-grid { grid-template-columns: repeat(3, 1fr); } .latest-grid, .archive-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 639px) { .section-heading { align-items: flex-start; flex-direction: column; gap: 0.6rem; } .note-row { gap: 1rem; } .note-row-right { display: none; } }
</style>
