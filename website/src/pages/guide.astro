---
import BaseLayout from '../components/layout/BaseLayout.astro';
import KeepInTouch from '../components/KeepInTouch.astro';
import CompareNotesCallout from '../components/CompareNotesCallout.astro';
import FlagshipJourney from '../components/FlagshipJourney.astro';

const sections = [
  { id: 'introduction', label: 'Introduction' },
  { id: 'part-1', label: 'Part 1 — The evidence problem' },
  { id: 'part-2', label: 'Part 2 — What the capability does' },
  { id: 'part-3', label: 'Part 3 — Where judgement matters' },
  { id: 'part-4', label: 'Part 4 — From discipline to OS' },
  { id: 'part-5', label: 'Part 5 — How capability develops' },
  { id: 'part-6', label: 'Part 6 — Skills worth developing' },
  { id: 'part-7', label: 'Part 7 — The first 90 days' },
  { id: 'closing', label: 'A final thought' },
];
---

<BaseLayout
  title="A Practical Guide to Editorial Intelligence"
  description="How B2B teams generate and develop evidence into stronger narratives, decisions and reusable knowledge."
  suppressFlagshipJourney
>
  <div class="guide-layout container-site py-16">

    <!-- Left nav -->
    <aside class="guide-nav">
      <div class="guide-nav-inner">
        <p class="guide-nav-title">A practical guide to Editorial Intelligence</p>
        <nav>
          <ul class="guide-nav-list">
            {sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="guide-nav-link">{s.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="guide-nav-footer">
          <a href="/editorial-intelligence-os" class="guide-nav-related">Explore the EI OS →</a>
          <a href="/assessment" class="guide-nav-related">Assess your organisation →</a>
          <a href="/work/narrative-audit" class="guide-nav-related">Explore the Narrative Audit →</a>
        </div>
      </div>
    </aside>

    <!-- Main content -->
    <main class="guide-content">

      <!-- Header -->
      <header class="guide-header">
        <p class="t-label mb-4">Guide</p>
        <h1 class="guide-title">A practical guide to Editorial Intelligence</h1>
        <p class="guide-subtitle">How B2B teams generate and develop evidence into stronger narratives, decisions and reusable knowledge</p>
      </header>

      <!-- Introduction -->
      <section id="introduction" class="guide-section">
        <a href="/start" class="guide-start-link">Need the map first? Start with the site orientation →</a>
        <p>Most B2B organisations do not lack content. They lack a reliable way of knowing what they know — and of turning that knowledge into something the business can act on.</p>
        <p>Research is published once and forgotten. Customer insight remains inside separate teams. Event conversations disappear into recordings. Product expertise is repeatedly translated from scratch. AI makes it easier to produce more, but it does not decide which evidence matters or what argument the organisation can credibly own.</p>
        <p>Editorial Intelligence addresses that gap.</p>
        <p class="guide-key">It is an evidence practice that combines qualitative research, editorial judgement, synthesis, narrative strategy, content development and organisational learning.</p>
        <p>This guide is for B2B research, thought-leadership, editorial and content leaders who want to build that capability. It is also for experienced writers whose work is expanding beyond production into synthesis, systems and organisational thinking.</p>
        <p>The practical question is no longer simply <em>“What should we publish?”</em> It is:</p>
        <p class="guide-question">What do we know, what do we still need to learn, what does the evidence mean and how can it continue creating value?</p>
      </section>

      <hr class="guide-divider" />

      <!-- Part 1 -->
      <section id="part-1" class="guide-section">
        <p class="guide-part-label">Part 1</p>
        <h2 class="guide-h2">The problem is not information. It is fragmentation.</h2>
        <p>Some organisations already hold valuable research, customer insight, market signals and specialist expertise, but that knowledge is distributed across reports, transcripts, dashboards, inboxes and individual memory. Others have material gaps that require new interviews, conversations, workshops or qualitative research before a credible position can be built.</p>
        <p>Traditional content workflows rarely fix this. They begin with an output requirement, move through briefing and production, then end at publication. Useful thinking is treated as an input to an asset rather than an organisational resource that should remain available.</p>
        <p>AI lowers the cost of drafting, summarising, editing and adaptation. That is useful, but it also exposes the real constraint. The difficult questions are now:</p>
        <ul class="guide-list">
          <li>Which evidence deserves attention?</li>
          <li>What pattern appears across different sources?</li>
          <li>What can the organisation credibly argue?</li>
          <li>How should that argument change for different audiences and contexts?</li>
          <li>What should be learned from the response?</li>
        </ul>
        <p class="guide-key">As production becomes easier, synthesis, direction and judgement become more valuable.</p>
      </section>

      <hr class="guide-divider" />

      <!-- Part 2 -->
      <section id="part-2" class="guide-section">
        <p class="guide-part-label">Part 2</p>
        <h2 class="guide-h2">What Editorial Intelligence does</h2>
        <p>Editorial Intelligence connects work that organisations often treat separately. It creates a repeatable movement from evidence to interpretation, from interpretation to activation and from audience response back to learning.</p>

        <div class="guide-tasks">
          {[
            { task: 'Generate', desc: 'Use interviews, conversations, workshops and qualitative research to answer important questions when sufficient evidence does not yet exist.' },
            { task: 'Capture', desc: 'Preserve useful research, customer insight, event conversations, practitioner expertise and market signals before they disappear.' },
            { task: 'Connect', desc: 'Bring evidence together across teams, formats and projects so recurring themes become visible.' },
            { task: 'Synthesise', desc: 'Use human judgement, supported by AI, to test patterns and decide what the evidence means.' },
            { task: 'Shape', desc: 'Turn the strongest interpretation into a clear narrative, position and editorial direction.' },
            { task: 'Activate', desc: 'Express the narrative through the formats, voices and experiences most useful to each audience.' },
            { task: 'Learn', desc: 'Treat performance, questions and audience response as new evidence that improves the next decision.' },
          ].map(t => (
            <div class="guide-task">
              <span class="guide-task-name">{t.task}</span>
              <p class="guide-task-desc">{t.desc}</p>
            </div>
          ))}
        </div>

        <p class="guide-key">The output may be an article, campaign, event, tool, sales narrative or product experience. The capability is the system that makes those outputs more connected and useful.</p>
      </section>

      <hr class="guide-divider" />

      <!-- Part 3 -->
      <section id="part-3" class="guide-section">
        <p class="guide-part-label">Part 3</p>
        <h2 class="guide-h2">Where human judgement matters</h2>
        <p>AI can compare large volumes of material, surface possible patterns and accelerate execution. It cannot take responsibility for what an organisation chooses to believe, argue or publish. That remains editorial work.</p>

        <div class="guide-judgements">
          {[
            { label: 'Spotting patterns', desc: 'Markets rarely change because of one event. Editorial thinkers notice repeated signals and distinguish an emerging pattern from an isolated anecdote.' },
            { label: 'Testing interpretation', desc: 'The same evidence can support several stories. Judgement means comparing explanations, challenging assumptions and refusing the most convenient conclusion when the evidence is weak.' },
            { label: 'Deciding what matters', desc: 'AI produces possibilities. People decide priorities. Knowing what to ignore is often more valuable than knowing what to include.' },
            { label: 'Finding the argument', desc: 'A collection of facts is not yet a position. Editorial judgement identifies the tension, point of view and practical consequence that make evidence meaningful.' },
            { label: 'Protecting trust', desc: 'Accuracy, provenance and context remain human responsibilities. A claim should not be published simply because a model can express it confidently.' },
          ].map((j, i) => (
            <div class="guide-judgement">
              <span class="guide-judgement-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <strong class="guide-judgement-label">{j.label}</strong>
                <p class="guide-judgement-desc">{j.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <hr class="guide-divider" />

      <!-- Part 4 -->
      <section id="part-4" class="guide-section">
        <p class="guide-part-label">Part 4</p>
        <h2 class="guide-h2">From discipline to operating system</h2>
        <p>Editorial Intelligence is the discipline. <a href="/editorial-intelligence-os">Editorial Intelligence OS</a> is the practical operating system that makes the discipline repeatable inside an organisation.</p>
        <p>The OS is not a fixed playbook. It is a living capability for continually updating how an organisation thinks, publishes and learns as technology, audiences and markets change.</p>

        <div class="guide-principles">
          {[
            { label: 'Evidence Engine', desc: 'Captures and connects the research, expertise and signals the organisation already holds.' },
            { label: 'Narrative Architecture', desc: 'Identifies the arguments and narrative territories the evidence can credibly support.' },
            { label: 'Editorial Strategy', desc: 'Sets priorities, audiences, formats and editorial direction.' },
            { label: 'Editorial Activation', desc: 'Turns narratives into coordinated articles, social posts, video, events, executive voices and experiences.' },
            { label: 'AI Visibility', desc: 'Makes knowledge clear, structured and retrievable for both people and AI systems.' },
            { label: 'Measurement', desc: 'Evaluates reach, use, influence and contribution at narrative level, not only asset level.' },
            { label: 'Continuous Learning', desc: 'Feeds audience response, performance and new evidence back into every other capability.' },
          ].map(p => (
            <div class="guide-principle">
              <strong>{p.label}</strong>
              <p>{p.desc}</p>
            </div>
          ))}
        </div>
        <p>The parts reinforce one another. Activation creates new signals. Measurement shows what people used, questioned or ignored. Continuous learning then updates the evidence, narrative and strategy.</p>
      </section>

      <FlagshipJourney embedded />

      <hr class="guide-divider" />

      <!-- Part 5 -->
      <section id="part-5" class="guide-section">
        <p class="guide-part-label">Part 5</p>
        <h2 class="guide-h2">How the capability develops</h2>
        <p>Editorial Intelligence is not something an organisation either has or lacks. It develops as evidence, judgement and learning become more connected and repeatable.</p>

        <div class="guide-stages">
          {[
            {
              stage: 'Stage 1',
              title: 'Content producer',
              desc: 'Work begins with briefs and output requirements. Useful evidence is often rediscovered for each project, and learning tends to end when an asset is published.',
            },
            {
              stage: 'Stage 2',
              title: 'Evidence collector',
              desc: 'Research and insight are preserved more consistently, but connections across teams and projects remain uneven. The organisation knows more than it can readily use.',
            },
            {
              stage: 'Stage 3',
              title: 'Editorial Intelligence practitioner',
              desc: 'Teams connect multiple evidence sources, use editorial judgement to shape narratives and activate those ideas across formats. The opportunity is to make the practice repeatable.',
            },
            {
              stage: 'Stage 4',
              title: 'Editorial Intelligence organisation',
              desc: 'Evidence is captured, synthesised, activated and reviewed through a shared system. Insight influences decisions across teams, learning compounds and AI supports judgement without replacing it.',
            },
          ].map((s, i) => (
            <div class="guide-stage">
              <div class="guide-stage-header">
                <span class="guide-stage-num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <span class="guide-stage-label">{s.stage}</span>
                  <strong class="guide-stage-title">{s.title}</strong>
                </div>
              </div>
              <p class="guide-stage-desc">{s.desc}</p>
            </div>
          ))}
        </div>
        <p>Experienced writers often become early practitioners because they already know how to interrogate evidence, recognise a story and protect trust. But the capability belongs across research, marketing, product, customer and leadership teams.</p>
      </section>

      <hr class="guide-divider" />

      <!-- Part 6 -->
      <section id="part-6" class="guide-section">
        <p class="guide-part-label">Part 6</p>
        <h2 class="guide-h2">Skills worth developing</h2>
        <p>The most valuable skills strengthen an organisation's ability to make sense of evidence and act on it. Few are purely production skills.</p>

        <div class="guide-skills">
          {[
            'Research synthesis',
            'Customer interviewing',
            'Evidence mapping',
            'Narrative architecture',
            'Editorial strategy',
            'Experience design',
            'Knowledge management',
            'AI orchestration',
            'Editorial activation',
            'Measurement design',
            'Cross-functional collaboration',
          ].map(s => (
            <div class="guide-skill">{s}</div>
          ))}
        </div>

        <p>Writing remains important. It is one expression of a broader capability that also shapes decisions, workflows, experiences and shared organisational knowledge.</p>
      </section>

      <hr class="guide-divider" />

      <!-- Part 7 -->
      <section id="part-7" class="guide-section">
        <p class="guide-part-label">Part 7</p>
        <h2 class="guide-h2">A practical first 90 days</h2>
        <p>Do not begin by designing a complete operating system. Start with one important narrative and use it to expose where evidence is lost, disconnected or underused.</p>

        <div class="guide-months">
          {[
            {
              month: 'Month one',
              actions: [
                'Choose one live business question or narrative',
                'Map the research, customer insight, expertise and performance evidence already available',
                'Identify important gaps, duplicated work and knowledge at risk of disappearing',
              ],
            },
            {
              month: 'Month two',
              actions: [
                'Compare evidence from at least three different sources',
                'Use AI to surface possible patterns, then test them with human judgement',
                'Create a narrative map before deciding which assets to produce',
              ],
            },
            {
              month: 'Month three',
              actions: [
                'Activate the narrative through the formats and voices that fit the audience',
                'Measure questions, use and response as well as reach',
                'Run a learning review and document what should change next time',
              ],
            },
          ].map(m => (
            <div class="guide-month">
              <span class="guide-month-label">{m.month}</span>
              <ul class="guide-month-actions">
                {m.actions.map(a => <li>{a}</li>)}
              </ul>
            </div>
          ))}
        </div>

        <p class="guide-key">The first useful outcome is not more content. It is a visible, repeatable path from evidence to action and back to learning.</p>
      </section>

      <hr class="guide-divider" />

      <!-- Closing -->
      <section id="closing" class="guide-section">
        <p class="guide-part-label">A final thought</p>
        <p>AI will continue making production faster and cheaper. That does not remove the need for editorial capability. It makes the difference between production and understanding harder to ignore.</p>
        <p>Organisations still need people who can recognise weak signals, test competing interpretations, connect ideas across teams and decide what deserves to become part of the organisation's point of view.</p>
        <p class="guide-key">Editorial Intelligence is not another content playbook. It is the capability to keep improving how an organisation thinks, publishes and learns.</p>

        <div class="guide-related">
          <p class="t-label mb-4">Choose your next step</p>
          <div class="guide-related-links">
            <a href="/editorial-intelligence-os" class="guide-related-link">
              <span>Explore Editorial Intelligence OS</span>
              <span class="guide-related-arrow">→</span>
            </a>
            <a href="/assessment" class="guide-related-link">
              <span>Assess your organisation across five dimensions</span>
              <span class="guide-related-arrow">→</span>
            </a>
            <a href="/work/narrative-audit" class="guide-related-link">
              <span>Explore the Narrative Audit</span>
              <span class="guide-related-arrow">→</span>
            </a>
            <a href="/intelligence" class="guide-related-link">
              <span>Read the definition of Editorial Intelligence</span>
              <span class="guide-related-arrow">→</span>
            </a>
          </div>
        </div>
      </section>

      <div class="guide-compare-notes">
        <CompareNotesCallout
          heading="Does this describe how your organisation works?"
          body="I’m comparing how different teams handle evidence, narrative and editorial learning — including where this guide fits and where it misses something important."
          linkLabel="Compare approaches"
          compact
        />
      </div>

      <div class="guide-lab-signup">
        <KeepInTouch />
      </div>

    </main>
  </div>
</BaseLayout>

<style>
  .guide-compare-notes { margin-top: 3rem; }
  .guide-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .guide-layout {
      grid-template-columns: 220px 1fr;
      gap: 4rem;
    }
  }

  /* Left nav */
  .guide-nav {
    display: none;
  }

  @media (min-width: 900px) {
    .guide-nav {
      display: block;
    }

    .guide-nav-inner {
      position: sticky;
      top: 2rem;
    }
  }

  .guide-nav-title {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .guide-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid var(--color-rule);
  }

  .guide-nav-link {
    display: block;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink-tertiary);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s;
    border-left: 2px solid transparent;
    margin-left: -1px;
  }

  .guide-nav-link:hover {
    color: var(--color-ink);
    border-left-color: var(--color-accent);
  }

  .guide-nav-footer {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-rule);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .guide-nav-related {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-ink-tertiary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .guide-nav-related:hover {
    color: var(--color-accent);
  }

  /* Content */
  .guide-header {
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .guide-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .guide-subtitle {
    font-size: 1rem;
    color: var(--color-ink-secondary);
    line-height: 1.6;
  }

  .guide-start-link {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-tertiary);
    text-decoration: none;
    margin-bottom: 1.5rem;
    transition: color 0.15s;
  }

  .guide-start-link:hover { color: var(--color-ink); }

  .guide-section {
    margin-bottom: 0;
    scroll-margin-top: 2rem;
  }

  .guide-section p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-ink-secondary);
    margin-bottom: 1.25rem;
    max-width: 64ch;
  }

  .guide-section p:last-child {
    margin-bottom: 0;
  }

  .guide-divider {
    border: none;
    border-top: 1px solid var(--color-rule);
    margin: 3rem 0;
  }

  .guide-part-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.5rem !important;
  }

  .guide-h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 2.5vw, 1.5rem);
    font-weight: 400;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .guide-question {
    font-style: italic;
    color: var(--color-ink-tertiary) !important;
  }

  .guide-key {
    font-family: var(--font-serif);
    font-size: 1.0625rem !important;
    color: var(--color-ink) !important;
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    margin-top: 1.75rem !important;
    font-style: italic;
  }

  .guide-list {
    margin: 0 0 1.25rem 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .guide-list li {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-secondary);
    padding-left: 1.25rem;
    position: relative;
  }

  .guide-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.6;
    font-size: 0.8125rem;
  }

  /* Tasks grid */
  .guide-tasks {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
    margin: 1.5rem 0;
  }

  .guide-task {
    background: var(--color-surface-secondary);
    padding: 1.125rem 1.25rem;
  }

  .guide-task-name {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: 0.375rem;
  }

  .guide-task-desc {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-tertiary);
    margin: 0 !important;
    max-width: none !important;
  }

  @media (max-width: 600px) {
    .guide-tasks { grid-template-columns: 1fr; }
  }

  /* Judgements */
  .guide-judgements {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .guide-judgement {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    align-items: start;
  }

  .guide-judgement-num {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    opacity: 0.7;
    padding-top: 0.2rem;
  }

  .guide-judgement-label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
    margin-bottom: 0.375rem;
  }

  .guide-judgement-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--color-ink-tertiary);
    margin: 0;
    max-width: none !important;
  }

  /* Principles */
  .guide-principles {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
    margin: 1.5rem 0;
  }

  .guide-principle {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-surface-secondary);
  }

  .guide-principle:last-child { border-bottom: none; }

  .guide-principle strong {
    display: block;
    font-size: 0.875rem;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .guide-principle p {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-ink-tertiary);
    margin: 0 !important;
    max-width: none !important;
  }

  /* Stages */
  .guide-stages {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  .guide-stage {
    padding: 1.25rem;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    background: var(--color-surface-secondary);
  }

  .guide-stage-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }

  .guide-stage-num {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    opacity: 0.7;
    padding-top: 0.3rem;
    flex-shrink: 0;
  }

  .guide-stage-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-accent);
    opacity: 0.7;
    letter-spacing: 0.04em;
    margin-bottom: 0.2rem;
  }

  .guide-stage-title {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .guide-stage-desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-ink-secondary);
    margin: 0;
    max-width: none !important;
  }

  /* Skills */
  .guide-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0;
  }

  .guide-skill {
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
    padding: 0.4rem 0.875rem;
    border: 1px solid var(--color-rule);
    border-radius: 2px;
    background: var(--color-surface-secondary);
  }

  /* 90 days */
  .guide-months {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
    margin: 1.5rem 0;
  }

  .guide-month {
    background: var(--color-surface-secondary);
    padding: 1.25rem;
  }

  .guide-month-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.875rem;
  }

  .guide-month-actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .guide-month-actions li {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-ink-secondary);
    padding-left: 1rem;
    position: relative;
  }

  .guide-month-actions li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    opacity: 0.5;
    font-size: 0.6875rem;
  }

  @media (max-width: 700px) {
    .guide-months { grid-template-columns: 1fr; }
  }

  /* Related links */
  .guide-related {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
  }

  .guide-related-links {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-rule);
    border-radius: 4px;
    overflow: hidden;
  }

  .guide-related-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    font-size: 0.875rem;
    color: var(--color-ink-secondary);
    background: var(--color-surface-secondary);
    transition: background 0.15s, color 0.15s;
  }

  .guide-related-link:last-child { border-bottom: none; }

  .guide-related-link:hover {
    background: var(--color-surface-tertiary);
    color: var(--color-ink);
  }

  .guide-related-arrow {
    color: var(--color-accent);
    opacity: 0.5;
    font-size: 0.8125rem;
  }
</style>

<script>
  // Highlight active nav link on scroll
  const links = document.querySelectorAll('.guide-nav-link');
  const sections = document.querySelectorAll('.guide-section');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          links.forEach(link => {
            link.style.borderLeftColor = 'transparent';
            link.style.color = '';
          });
          const active = document.querySelector(`.guide-nav-link[href="#${entry.target.id}"]`);
          if (active) {
            active.style.borderLeftColor = 'var(--color-accent)';
            active.style.color = 'var(--color-ink)';
          }
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sections.forEach(s => observer.observe(s));
</script>
