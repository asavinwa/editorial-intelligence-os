---
const rawPathname = Astro.url.pathname;
const pathname = rawPathname !== '/' ? rawPathname.replace(/\/+$/, '') : '/';

const journeys: Record<string, {
  eyebrow: string;
  title: string;
  body: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}> = {
  '/applications': {
    eyebrow: 'Flagship application',
    title: 'Editorial Intelligence for marketing',
    body: 'How Editorial Intelligence connects research, customer evidence, campaign learning and internal expertise across a modern marketing organisation.',
    primaryLabel: 'Explore the marketing application',
    primaryHref: '/applications/marketing',
  },
  '/guide': {
    eyebrow: 'Application',
    title: 'See the discipline applied to marketing',
    body: 'Use the marketing application as a practical example after exploring the core discipline in this guide.',
    primaryLabel: 'Explore the marketing application',
    primaryHref: '/applications/marketing',
  },
  '/editorial-intelligence-os': {
    eyebrow: 'Application',
    title: 'Editorial Intelligence for marketing',
    body: 'See how the operating system connects evidence, narrative, activation and learning across specialist marketing functions.',
    primaryLabel: 'Explore the application',
    primaryHref: '/applications/marketing',
    secondaryLabel: 'See all applications',
    secondaryHref: '/applications',
  },
  '/assessment': {
    eyebrow: 'Useful context',
    title: 'See what connected Editorial Intelligence looks like',
    body: 'The marketing application provides a practical example of the organisational capability this assessment explores.',
    primaryLabel: 'Read the marketing application',
    primaryHref: '/applications/marketing',
  },
  '/compare-notes': {
    eyebrow: 'Optional reading',
    title: 'Editorial Intelligence for marketing',
    body: 'A practical example to read before we compare how evidence, expertise and learning move through your organisation.',
    primaryLabel: 'Read the application',
    primaryHref: '/applications/marketing',
  },
  '/work/narrative-audit': {
    eyebrow: 'Related thinking',
    title: 'From application to implementation',
    body: 'The marketing application explains the capability. The Narrative Audit applies it to the evidence already inside an organisation.',
    primaryLabel: 'Read the marketing application',
    primaryHref: '/applications/marketing',
  },
};

const journey = journeys[pathname];
const isApplications = pathname === '/applications';
---

{journey && pathname !== '/applications/marketing' && (
  <aside
    class:list={['flagship-journey', isApplications && 'flagship-journey--application']}
    data-flagship-placement={isApplications ? 'applications' : undefined}
    aria-label="Recommended Editorial Intelligence journey"
  >
    <div class:list={['flagship-journey-inner', !isApplications && 'container-site']}>
      <div class="flagship-journey-copy">
        <p class="t-label">{journey.eyebrow}</p>
        <h2>{journey.title}</h2>
        <p>{journey.body}</p>
      </div>
      <div class="flagship-journey-actions">
        <a class="flagship-primary" href={journey.primaryHref}>{journey.primaryLabel} →</a>
        {journey.secondaryHref && journey.secondaryLabel && (
          <a class="flagship-secondary" href={journey.secondaryHref}>{journey.secondaryLabel} →</a>
        )}
      </div>
    </div>
  </aside>
)}

{isApplications && (
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const flagship = document.querySelector('[data-flagship-placement="applications"]');
      const applicationGrid = document.querySelector('.app-grid');
      if (flagship && applicationGrid) applicationGrid.prepend(flagship);
    });
  </script>
)}

<style>
  .flagship-journey {
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-surface-secondary);
  }
  .flagship-journey-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .flagship-journey-copy { max-width: 46rem; }
  .flagship-journey-copy h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.25rem, 2.2vw, 1.8rem);
    line-height: 1.25;
    color: var(--color-ink);
  }
  .flagship-journey-copy > p:last-child {
    margin-top: 0.5rem;
    color: var(--color-ink-secondary);
    line-height: 1.65;
  }
  .flagship-journey-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    min-width: 13rem;
  }
  .flagship-primary,
  .flagship-secondary {
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .flagship-primary { color: var(--color-accent); font-weight: 600; }
  .flagship-secondary { color: var(--color-ink-secondary); }
  .flagship-primary:hover,
  .flagship-secondary:hover { color: var(--color-ink); }

  .flagship-journey--application {
    order: -1;
    border: 1px solid color-mix(in srgb, var(--color-accent) 52%, var(--color-rule));
    border-left: 4px solid var(--color-accent);
    border-radius: 8px;
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-accent) 12%, transparent), transparent 58%),
      var(--color-surface-secondary);
    box-shadow: 0 12px 36px color-mix(in srgb, var(--color-accent) 10%, transparent);
    overflow: hidden;
  }
  .flagship-journey--application .flagship-journey-inner {
    padding: 1.75rem;
  }
  .flagship-journey--application .flagship-journey-copy h2 {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
  }
  .flagship-journey--application .t-label {
    color: var(--color-accent);
  }
  .flagship-journey--application .flagship-primary {
    display: inline-flex;
    padding: 0.75rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--color-accent) 55%, transparent);
    border-radius: 4px;
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  @media (max-width: 760px) {
    .flagship-journey-inner { grid-template-columns: 1fr; gap: 1.25rem; }
    .flagship-journey-actions { min-width: 0; }
    .flagship-journey--application .flagship-journey-inner { padding: 1.35rem; }
  }
</style>
