---
export interface Props {
  variant?: 'compact' | 'full';
  eyebrow?: string;
  headline?: string;
  body?: string;
}

const {
  variant = 'compact',
  eyebrow,
  headline = variant === 'full'
    ? 'Join the first 100 readers'
    : 'Follow the discipline as it develops',
  body,
} = Astro.props;
---

<div class={`lab-signup lab-signup--${variant}`}>
  {eyebrow && <p class="lab-signup-eyebrow">{eyebrow}</p>}
  {headline && <p class="lab-signup-headline">{headline}</p>}
  {body && <p class="lab-signup-body">{body}</p>}
  <div class="lab-signup-action">
    <a
      href="https://editorialintelligence.substack.com/subscribe?utm_source=editorialintelligence.co&utm_medium=website"
      class="lab-signup-button"
      target="_blank"
      rel="noopener noreferrer"
      onclick="window.va?.('track', 'substack_subscribe_click')"
    >Subscribe to the Lab <span aria-hidden="true">→</span></a>
    <span class="lab-signup-note">Free · Opens in Substack</span>
  </div>
</div>

<style>
  .lab-signup {
    margin: 2rem 0;
  }

  .lab-signup--compact {
    padding: 1.5rem;
    border: 1px solid var(--color-rule);
    border-left: 2px solid var(--color-accent);
    border-radius: 4px;
    background: var(--color-surface-secondary);
  }

  .lab-signup-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .lab-signup-headline {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--color-ink);
    margin-bottom: 0.25rem;
  }

  .lab-signup--full .lab-signup-headline {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .lab-signup-body {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-secondary);
    margin-bottom: 0.75rem;
    max-width: 52ch;
  }

  .lab-signup-action {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 1rem;
  }

  .lab-signup-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 3px;
    background: var(--color-accent);
    color: var(--color-surface);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .lab-signup-button:hover {
    opacity: 0.86;
  }

  .lab-signup-note {
    color: var(--color-ink-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
  }

  @media (max-width: 767px) {
    .lab-signup {
      margin: 1.5rem 0;
    }

    .lab-signup--compact {
      padding: 1.25rem;
    }

    .lab-signup-eyebrow,
    .lab-signup-button,
    .lab-signup-note {
      font-size: 0.75rem;
    }

    .lab-signup-headline {
      font-size: 1.125rem;
      line-height: 1.35;
    }

    .lab-signup--full .lab-signup-headline {
      font-size: 1.5rem;
    }

    .lab-signup-body {
      font-size: 0.9375rem;
    }
  }
</style>
